# Режим работы системы стандартов
# public - только пользовательская загрузка
# enterprise - можно подключить официальный API метаданных
STANDARDS_MODE=public

# База данных PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cnc_assistant

# Redis для кэширования
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Пути хранения стандартов
STANDARDS_STORAGE_DIR=standards_storage
STANDARDS_UPLOAD_DIR=standards_storage/uploads

# Интервал проверки обновлений (дни)
UPDATE_CHECK_INTERVAL_DAYS=180

# TTL кэша (часы)
CACHE_TTL_HOURS=24

# Enterprise API (только для enterprise режима)
# ENTERPRISE_API_URL=https://api.example.com
# ENTERPRISE_API_KEY=your_api_key_here

# Логирование
LOG_LEVEL=INFO
