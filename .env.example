# Конфигурация CNC Assistant Bot
# Скопируйте этот файл в .env и замените значения

# Токен вашего Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=ваш_токен_бота_здесь

# Опционально: путь к Tesseract OCR (если не в PATH)
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: TESSERACT_CMD=/usr/bin/tesseract
# TESSERACT_CMD=

# Путь к файлу с правилами обработки (YAML)
RULES_FILE_PATH=data/rules/cutting_modes.yaml

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log

# Язык по умолчанию
DEFAULT_LANGUAGE=ru

# Настройки FSM (машины состояний)
FSM_ENABLED=true
FSM_DEBUG=true

# Настройки памяти
MEMORY_ENABLED=true
MEMORY_PATH=data/memory

# API (для будущего использования)
# API_BASE_URL=http://localhost:8000
# API_ENABLED=false